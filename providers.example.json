    "lmstudio": {
      "base_url": "http://10.0.0.63:1234/v1",
      "model": "auto"
    },
    "ollama": {
      "base_url": "http://10.0.0.63:11434/v1",
      "model": "qwen3:8b"
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.2",
      "api_key_env": "OPENAI_API_KEY"
    }
  }
}
