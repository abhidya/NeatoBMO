{
  "_comment": "Copy to ~/.neatobmo/providers.json. First reachable provider in 'order' wins.",
  "order": ["colibri", "lmstudio", "ollama", "openai"],
  "providers": {
    "colibri": {
      "base_url": "http://127.0.0.1:8000/v1",
      "model": "olmoe",
