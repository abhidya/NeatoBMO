# build artifacts
esp32-body/.pio/
esp32-body/tools/build/
esp32-body/sdkconfig.esp32s3
esp32-body/managed_components/
esp32-body/dependencies.lock
__pycache__/
*.pyc
.DS_Store

# private/copyrighted soundboard build intermediates; publish docs/*.bin only
assets/bmo-soundboard-library-*/

# tool state
.omx/
tmp/

# private hardware acquisition material; do not publish raw dumps/backups
neato-jtag-private/
*-jtag-private/
esp32-before-jtag-full.bin
*.dump.bin
captures/jtag/**/sram*.bin
captures/jtag/**/sdram*.bin
captures/jtag/*/private/
.worktrees/

# local ESP32 provisioning credentials (NVS remains the device source of truth)
esp32-body/wifi.local.env

# NeatoOS local build/probe outputs (reference-header probe contains
# caller-supplied vendor header bytes and must never be committed)
neatoos/build/
neatoos/tools/__pycache__/

# BMOQ evaluation working state: checkpoints, venv, and generated run outputs.
# Benchmark corpora are reproducible from build_corpus.py plus the committed
# .meta.json provenance, so the token files themselves are not tracked.
.models/
.venv*/
runs/
*.bmoq
